{
  "name": "stillframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A first-person ASCII shooter where time moves only when you move.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-levels": "tsx tools/validate-levels.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate-levels",
    "screenshot": "vite build && tsx tools/screenshot.ts"
  },
  "dependencies": {
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
